# 内存 单位MB
megs: 128

# 设置BIOS和VGA BIOS
romimage: file=./bochsConfigs/BIOS-bochs-latest, options=fastboot
vgaromimage: file=./bochsConfigs/VGABIOS-lgpl-latest

# 硬盘启动
boot: disk

#日志
log: bochs.log

#鼠标和键盘
mouse: enabled=0 
keyboard: keymap=./bochsConfigs/x11-pc-us.map
#硬盘设置
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, mode=flat, path="c.img"
ata0-slave: type=disk, mode=flat, path="d.img"

ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, irq=15
ata1-master: type=disk, mode=flat, path="e.img"

cpu: count=1, ips=200000000, model=bx_generic, reset_on_triple_fault=1, cpuid_limit_winnt=0, ignore_bad_msrs=1, mwait_is_nop=0, msrs="msrs.def"
cpuid: level=6, stepping=3, model=3, family=6
cpuid: mmx=true, apic=xapic, simd=sse2, sse4a=false, misaligned_sse=false, sep=true
cpuid: movbe=false, adx=false, aes=false, sha=false, xsave=false, xsaveopt=false, x86_64=true
cpuid: 1g_pages=false, pcid=false, fsgsbase=false, smep=false, smap=false, mwait=true
cpuid: vmx=1

#时钟配置, 配置为同步，不同步的话bochs里面的时钟比实际的快很多
clock: sync=realtime, rtc_sync=1, time0=local
